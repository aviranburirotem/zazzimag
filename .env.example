# Paste real values in Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Long-lived Instagram token from the Meta developer dashboard
IG_ACCESS_TOKEN=

# Random secret that protects the token-refresh job (any long random string)
CRON_SECRET=

# Added automatically when you connect Upstash Redis in Vercel → Storage.
# Used to store the refreshed token so it never expires.
KV_REST_API_URL=
KV_REST_API_TOKEN=
